{
  "name": "strudel-jelly",
  "version": "0.1.0",
  "description": "A local, offline Strudel live-coding app",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite build && electron .",
    "build": "vite build",
    "host:build": "node host/build.mjs",
    "dist": "vite build && electron-builder --win dir"
  },
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/view": "^6.43.15",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@strudel/codemirror": "^1.3.0",
    "@strudel/core": "^1.2.6",
    "@strudel/draw": "^1.2.6",
    "@strudel/hydra": "^1.2.6",
    "@strudel/midi": "^1.3.0",
    "@strudel/mini": "^1.2.6",
    "@strudel/soundfonts": "^1.3.0",
    "@strudel/tonal": "^1.2.6",
    "@strudel/transpiler": "^1.2.6",
    "@strudel/webaudio": "^1.3.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.17.0",
    "superdough": "^1.3.0",
    "vite": "^8.3.3"
  },
  "allowScripts": {
    "electron@45.1.0": true
  },
  "productName": "Strudel Jelly",
  "private": true,
  "build": {
    "appId": "dev.local.strudeljelly",
    "productName": "Strudel Jelly",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": "dir"
    },
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "electronVersion": "45.1.0",
    "extraResources": [
      {
        "from": "host/bin/jelly-host.exe",
        "to": "host/jelly-host.exe"
      },
      {
        "from": "host/bin/jelly-bridge32.exe",
        "to": "host/jelly-bridge32.exe"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      }
    ]
  }
}
